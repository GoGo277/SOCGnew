{
  "name": "g-eyes-sr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && npm --prefix functions run typecheck",
    "test": "vitest run",
    "test:emulators": "node scripts/emulator-env.mjs && npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-geyes \"vitest run --config vitest.emulator.config.ts\"",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/i18n-keys.mjs --check",
    "test:all": "npm run lint && npm test && npm run i18n:check && npm run test:emulators && npm run test:e2e",
    "deploy": "npm run build && firebase deploy --only hosting,firestore,functions",
    "build:demo": "vite build --mode demo",
    "demo": "vite build --mode demo && vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "@tailwindcss/vite": "^4.2.1",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.563.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.35.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@firebase/app-compat": "0.5.18",
    "@firebase/app": "0.16.2"
  }
}