# --- Google Cloud Firebase (cloud mode) --------------------------------------
# With these set, G-Eyes SR uses Firebase Authentication (+ TOTP MFA), custom-claim
# roles, Cloud Functions and real-time Firestore sync. Leave empty for local
# evaluation mode (single browser, cross-tab sync).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Region the Cloud Functions are deployed to (default us-central1)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Point the app at the local Emulator Suite (auth 9099, firestore 8080, functions 5001)
VITE_USE_FIREBASE_EMULATORS=false

# --- Supabase (optional, legacy asset/incident inventory) ---------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
