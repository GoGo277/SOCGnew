{
  "name": "geyes-functions",
  "private": true,
  "description": "G-Eyes SR server-side security: identity & role administration, report sealing, audit sink, scheduled reporting.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --external:firebase-functions --external:firebase-admin --log-level=warning && esbuild src/bootstrap.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/bootstrap.js --external:firebase-functions --external:firebase-admin --log-level=warning",
    "typecheck": "tsc --noEmit -p .",
    "bootstrap-admin": "node lib/bootstrap.js"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "5.8"
  }
}