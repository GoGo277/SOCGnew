rules_version = '2';

// G-Eyes SR — Firestore security rules
//
// Identity: Firebase Authentication. Role: custom claim `role` (Admin | L1 | L2)
// set only by Cloud Functions. Administrator writes additionally require a
// second factor (TOTP) while app_settings/global.requireAdminMfa is on.
// Integrity guarantees enforced here regardless of the client:
//   * finalized shift reports are immutable and can only be sealed server-side
//   * audit_logs, handover_acks and report_archive are append-only
//   * workflows (swaps, handovers) follow their state machines
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isMember() { return role() in ['Admin', 'L1', 'L2']; }
    function uname() { return request.auth.token.get('name', ''); }
    function settingsDoc() { return /databases/$(database)/documents/app_settings/global; }
    function mfaPolicyOn() {
      return !exists(settingsDoc()) || get(settingsDoc()).data.get('requireAdminMfa', true) != false;
    }
    function hasSecondFactor() {
      return request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null;
    }
    function isAdmin() { return role() == 'Admin' && (!mfaPolicyOn() || hasSecondFactor()); }
    function incoming() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isDateKey(k) { return k.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // ---- Identity ---------------------------------------------------------
    match /users/{uid} {
      allow read: if isMember();
      // Accounts are created / changed by Cloud Functions; users may edit their profile only.
      allow update: if signedIn() && request.auth.uid == uid
        && changed().hasOnly(['bio', 'profilePic', 'lastSeen']);
      allow create, delete: if false;
    }

    // Username -> sign-in e-mail lookup used before authentication (single-document get only).
    match /login_index/{name} {
      allow get: if true;
      allow list, write: if false;
    }

    match /app_settings/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ---- Roster -------------------------------------------------------------
    match /duty_schedules/{dateKey} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && isDateKey(dateKey)
        && incoming().date == dateKey
        && incoming().morning is list && incoming().evening is list && incoming().night is list;
      allow delete: if isAdmin();
    }

    match /shift_swaps/{swapId} {
      allow read: if isMember();
      allow create: if isMember()
        && incoming().requesterId == request.auth.uid
        && incoming().status == 'pending_peer'
        && incoming().id == swapId;
      allow update: if isMember() && (
        // colleague accepts / declines
        (resource.data.status == 'pending_peer' && resource.data.peerId == request.auth.uid
          && incoming().status in ['pending_admin', 'declined']
          && changed().hasOnly(['status', 'peerRespondedAt']))
        // requester cancels while pending
        || (resource.data.requesterId == request.auth.uid
          && resource.data.status in ['pending_peer', 'pending_admin']
          && incoming().status == 'cancelled'
          && changed().hasOnly(['status', 'decidedAt', 'decidedBy']))
        // administrator decides
        || (isAdmin() && resource.data.status == 'pending_admin'
          && incoming().status in ['approved', 'rejected']
          && changed().hasOnly(['status', 'decidedAt', 'decidedBy', 'decisionNote']))
      );
      allow delete: if false;
    }

    // ---- Shift reporting ---------------------------------------------------
    // shift_reports/{YYYY-MM-DD}_{morning|evening|night}
    match /shift_reports/{reportId} {
      allow read: if isMember();
      allow create: if isMember()
        && reportId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_(morning|evening|night)$')
        && incoming().id == reportId
        && incoming().status == 'draft'
        && incoming().events is list
        && incoming().createdById == request.auth.uid;
      // Drafts only. Finalization (status -> finalized) is performed by the
      // finalizeShiftReport Cloud Function, which bypasses these rules.
      allow update: if isMember()
        && resource.data.status == 'draft'
        && incoming().status == 'draft'
        && incoming().id == resource.data.id
        && incoming().createdAt == resource.data.createdAt
        && incoming().createdById == resource.data.createdById
        && incoming().events is list
        && !('integrityHash' in incoming());
      allow delete: if isAdmin();
    }

    match /handover_acks/{reportId} {
      allow read: if isMember();
      allow create: if isMember()
        && incoming().reportId == reportId
        && incoming().acknowledgedById == request.auth.uid
        && get(/databases/$(database)/documents/shift_reports/$(reportId)).data.status == 'finalized';
      allow update, delete: if false;
    }

    // ---- Reporting ----------------------------------------------------------
    match /report_templates/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().createdBy == uname();
      allow update, delete: if isAdmin() || (isMember() && resource.data.createdBy == uname());
    }

    match /report_schedules/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /report_archive/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().generatedBy == uname() && incoming().sha256 is string;
      allow update, delete: if false;
    }

    // ---- Audit --------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && incoming().id == logId
        && incoming().userId == request.auth.uid
        && incoming().username == uname()
        && incoming().action is string
        && incoming().timestamp is string
        && incoming().hash is string;
      allow update, delete: if false;
    }

    match /audit_integrity_alerts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Case management (DFIR-IRIS compatible) ---------------------------
    match /customers/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /case_templates/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /cases/{caseId} {
      allow read: if isMember();
      allow create: if isMember()
        && incoming().id == caseId
        && incoming().number is int
        && incoming().state == 'Open'
        && incoming().openedBy == uname();
      allow update: if isMember()
        && incoming().id == resource.data.id
        && incoming().number == resource.data.number
        && incoming().openedAt == resource.data.openedAt
        // closing requires an outcome
        && (incoming().state != 'Closed' || incoming().outcome != 'Unknown');
      allow delete: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if isMember();
      allow create: if isMember() && incoming().id == alertId && incoming().number is int && incoming().createdBy == uname();
      allow update: if isMember()
        && incoming().id == resource.data.id
        && incoming().number == resource.data.number
        && incoming().createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /case_iocs/{id} { allow read: if isMember(); allow create, update: if isMember() && incoming().caseId is string; allow delete: if isMember(); }
    match /case_assets/{id} { allow read: if isMember(); allow create, update: if isMember() && incoming().caseId is string; allow delete: if isMember(); }
    match /case_timeline/{id} { allow read: if isMember(); allow create, update: if isMember() && incoming().caseId is string; allow delete: if isMember(); }
    match /case_notes/{id} { allow read: if isMember(); allow create, update: if isMember() && incoming().caseId is string; allow delete: if isMember(); }
    match /case_tasks/{id} { allow read: if isMember(); allow create, update: if isMember() && incoming().caseId is string; allow delete: if isMember(); }

    // Evidence: chain of custody can only grow; the file hash never changes.
    match /case_evidence/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().caseId is string && incoming().sha256 is string && incoming().custody is list;
      allow update: if isMember()
        && incoming().sha256 == resource.data.sha256
        && incoming().custody.size() >= resource.data.custody.size();
      allow delete: if isAdmin();
    }

    // Case activity feed is append-only.
    match /case_activity/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().by == uname();
      allow update, delete: if false;
    }

    // Monotonic sequence counters (case / alert numbers): +1 only.
    match /counters/{name} {
      allow read: if isMember();
      allow create: if isMember() && name in ['case', 'alert'] && incoming().value == 1;
      allow update: if isMember() && incoming().value == resource.data.value + 1;
      allow delete: if false;
    }

    // IRIS connector state is server-managed.
    match /integrations/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // mail, login_failure_rate and everything else: server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
